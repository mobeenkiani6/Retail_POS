# Copy to .env and adjust. Used when running backend natively (DB in Docker).
DATABASE_URL=postgresql://sootshoot:password123@localhost:5433/sootshoot
SECRET_KEY=your_secret_key_change_in_production
PORT=5001
# Production: debug off, eventlet for concurrency (Windows-safe)
FLASK_ENV=production

# Single-branch scope — 32-char hex id shared with the admin panel for this store.
# Generate with: python -c "import uuid; print(uuid.uuid4().hex)"
# Leave blank to use the branch id created at /auth/setup.
BRANCH_ID=
